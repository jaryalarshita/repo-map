PORT=3001
DEEPMIND_API_KEY=your_key_here

# Comma-separated list of origins allowed to call this API (CORS).
# Defaults to http://localhost:5173 (Vite dev server) if unset.
ALLOWED_ORIGINS=http://localhost:5173

# Optional: raises the GitHub API rate limit from 60/hr to 5,000/hr.
# Create a token at https://github.com/settings/tokens (no scopes needed
# for public repos).
GITHUB_TOKEN=

# Max size (in bytes) of a repository ZIP this server will download.
# Defaults to 150 MB if unset.
MAX_REPO_BYTES=157286400
